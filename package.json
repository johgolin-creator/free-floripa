{
  "name": "free-floripa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "cap:android": "tsc -b && vite build && node scripts/prepare-sites-build.mjs && cap add android",
    "cap:ios": "tsc -b && vite build && node scripts/prepare-sites-build.mjs && cap add ios",
    "cap:sync": "tsc -b && vite build && node scripts/prepare-sites-build.mjs && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
